# Environment: 
## Modify the value above to identify the system's environment. Options:
### Local - for local development and testing
### UAT - for User Acceptance Testing (UAT) environment
### Production - for production environment

# System Environment Variables
## START::Required
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PRODUCTION_URLS=
APP_TIMEZONE=UTC
SCOUT_DRIVER=database
## END::Required
## START::Optional
DEBUGBAR_ENABLED=false # used for Barryvdh/DebugBar
## END::Optional

# System Security Variables
## START::Required
CSP_MODE= # report-only, enforce, off
## END::Required
## START::Optional
## END::Optional

# System API Variables
## START::Required
API_TEST_KEY=
API_KEYS=
API_FUNERAL_ASSISTANCE_KEY=
## END::Required
## START::Optional
## END::Optional

# System Account Variables
## START::Required
ADMIN_PASSWORD=
CSWDO_DEPT_HEAD= # Used in certificates
CSWDO_SOCIAL_WELFARE_OFFICER= # Used in certificates
CSWDO_DEPARTMENT_EMAIL=
CSWDO_WORK_HOURS_START=8
CSWDO_WORK_HOURS_END=16
## END::Required
## START::Optional
## END::Optional

# TLC Portal Variables
## Used for fetching citizen info, notifications, and handling logging into this system
## PREREQUISITES:
### 1. TLC Portal endpoint/url for account redirect when logging out from this system
### 2. TLC Portal user's API endpoint and API Key for fetching citizen info used in accounts
### 3. SSO key to verify the request from TLC Portal to this system
### 4. TLC Portal Notification Endpoint and API Key for sending notifications to the citizen's portal account
## START::Required
PORTAL_ENDPOINT=
### START::Users
PORTAL_USERS_SSO_SECRET_KEY=
PORTAL_USERS_GET_ENABLE=false
PORTAL_USERS_GET_ENDPOINT=
PORTAL_USERS_GET_API_KEY=
### END::Users
### START::Notifications
PORTAL_NOTIFICATION_POST_ENABLE=false
PORTAL_NOTIFICATION_POST_ENDPOINT=
PORTAL_NOTIFICATION_POST_API_KEY=
### END::Notifications
## END::Required
## START::Optional
PORTAL_MOCK=false # For testing purposes only, it replicates how a citizen accesses this system
PORTAL_USERS_SEEDER=false # For testing purposes only, populates the database with preset citizen data, ensure the mock is enabled
## END::Optional

# File Server Variables
## PREREQUISITES:
### 1. Full API URL including /apiburial/ (or the direct PHP script). Use the same URL for GET and POST.
### 2. Undated system secret, identical for GET and POST. Burial prepends YYYYMMDD on every request.
## START::Required
FILESERVER_GET_ENABLE=false
FILESERVER_GET_ENDPOINT=
FILESERVER_GET_API_KEY=
FILESERVER_POST_ENABLE=false
FILESERVER_POST_ENDPOINT=
FILESERVER_POST_API_KEY=
## END::Required
## START::Optional
FILESERVER_ENCRYPTION_KEY= # Required when uploading or reading encrypted documents; preserve existing keys
### START::Mock
#### For testing purposes, use a mock file server that replicates the behavior of a fileserver.
FILESERVER_MOCK=false
FILESERVER_MOCK_TOKEN=
FILESERVER_MOCK_PORT=8099
FILESERVER_MOCK_DUPLICATES=reject
FILESERVER_MOCK_MAX_UPLOAD_KB=30720
### END::Mock
## END::Optional

# SMS Variables
## PREREQUISITES:
### 1. SMS API
### 2. SMS Endpoint
### 3. SMS API Key
## START::Required
### Note: no GET endpoint because the SMS system does not provide SMS fetching capabilities
SMS_POST_ENABLE=false
SMS_POST_ENDPOINT=
SMS_POST_API_KEY=
## END::Required
## START::Optional
## END::Optional

# PSA Classifications API Variables
## Necessary for fetching geographical classifications for addresses
## PREREQUISITES:
### 1. PSA Classificiations API Endpoint
### 2. PSA Classifications API Key
### 3. PSA Classifications API Version
## START::Required
PSA_CLASSIFICATION_GET_ENABLE=true
PSA_CLASSIFICATION_GET_ENDPOINT=
PSA_CLASSIFICATION_GET_VERSION=
PSA_CLASSIFICATION_GET_API_KEY=
# Note: no POST endpoint because PSA does not allow data submissions
## END::Required
## START::Optional
## END::Optional

# Log Values
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Values
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Session Values
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache Host
MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=false
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=15
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Mail Logs
## PREREQUISITES:
### 1. Shared database for email logs and its credentials
# Shared suppression checks are mandatory. Enable the isolated mock locally,
# then run: php artisan email-logs:mock-init
## START::Required
EMAIL_LOGS_DB_HOST=
EMAIL_LOGS_DB_PORT=3306
EMAIL_LOGS_DB_DATABASE=
EMAIL_LOGS_DB_USERNAME=
EMAIL_LOGS_DB_PASSWORD=
## END::Required
## START::Optional
EMAIL_LOGS_MOCK=false
## END::Optional

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# VITE
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
